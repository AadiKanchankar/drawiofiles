  <diagram name="Page-1" id="qfPVhCIcktDP44OyKs1-">
    <mxGraphModel dx="4287" dy="2547" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml Sequence_HighValueTransfer\nautonumber\nskinparam shadowing false\nskinparam sequenceMessageAlign left\n\nactor \&quot;Customer\&quot; as C\nparticipant \&quot;Voice Gateway\&quot; as VG\nparticipant \&quot;ASR Service\&quot; as ASR\nparticipant \&quot;Dialogue Manager\&quot; as DM\nparticipant \&quot;Risk Engine\&quot; as RE\nparticipant \&quot;Authentication Service\&quot; as AUTH\nparticipant \&quot;Banking Adapter\&quot; as BA\nparticipant \&quot;Escalation Engine\&quot; as ESC\nparticipant \&quot;Audit Ledger Service\&quot; as AUD\nparticipant \&quot;TTS Service\&quot; as TTS\nactor \&quot;Human Agent\&quot; as HA\n\nC -&gt; VG : startSession()\nactivate VG\nVG -&gt;&gt; AUD : logEvent(SESSION_START, consentToken)\n\nC -&gt; VG : speak(audioStream)\nVG -&gt; ASR : transcribe(audioStream)\nactivate ASR\nASR -&gt; ASR : detectLanguage()\nASR --&gt; VG : Transcript(text, lang, confidence)\ndeactivate ASR\nVG -&gt;&gt; AUD : logEvent(ASR_OUTPUT, transcriptHash)\n\nVG -&gt; DM : handleTurn(conversationId, transcript)\nactivate DM\nDM -&gt; DM : classifyIntent()\nDM -&gt;&gt; AUD : logEvent(INTENT_DETECTED, intentCode, confidence)\n\nDM -&gt; RE : assess(intentCode, amount, lastVerifyScore, history)\nactivate RE\nRE --&gt; DM : RiskAssessment(riskScore, tier)\ndeactivate RE\nDM -&gt;&gt; AUD : logEvent(RISK_DECISION, riskScore, tier)\n\nalt tier == TRANSACTIONAL\n  DM -&gt; AUTH : verifySpeaker(conversationId, voiceSample)\n  activate AUTH\n  AUTH --&gt; DM : VoiceVerification(speakerScore, spoofScore, result)\n  deactivate AUTH\n  DM -&gt;&gt; AUD : logEvent(AUTH_ATTEMPT, method, result)\n\n  alt result == PASS\n    opt amount &gt; tierThreshold\n      DM -&gt; AUTH : sendAndVerifyOTP(customerId)\n      activate AUTH\n      AUTH --&gt; DM : OTPVerification(result)\n      deactivate AUTH\n    end\n    DM -&gt; BA : executeTransfer(customerId, payee, amount)\n    activate BA\n    BA --&gt; DM : BankingResult(status, coreReferenceNo)\n    deactivate BA\n    DM -&gt;&gt; AUD : logEvent(BANKING_CALL, coreReferenceNo, status)\n    DM --&gt; VG : Response(readBackConfirmation, lang)\n  else result == FAIL or spoofScore high\n    DM -&gt; ESC : raise(conversationId, SUSPECTED_SPOOF)\n    activate ESC\n    ESC -&gt; HA : assignWithContext(transcript, intent, riskAssessment)\n    HA --&gt; ESC : accepted(agentId)\n    ESC --&gt; DM : Escalation(status)\n    deactivate ESC\n    DM -&gt;&gt; AUD : logEvent(ESCALATION, SUSPECTED_SPOOF, agentId)\n    DM --&gt; VG : Response(handoverMessage, lang)\n  end\n\nelse tier == HIGH_RISK\n  DM -&gt; ESC : raise(conversationId, HIGH_VALUE_TRANSFER)\n  activate ESC\n  ESC -&gt; HA : assignWithContext(transcript, intent, riskAssessment)\n  HA --&gt; ESC : accepted(agentId)\n  ESC --&gt; DM : Escalation(status)\n  deactivate ESC\n  DM -&gt;&gt; AUD : logEvent(ESCALATION, HIGH_VALUE_TRANSFER, agentId)\n  DM --&gt; VG : Response(handoverMessage, lang)\nend\ndeactivate DM\n\nVG -&gt; TTS : synthesize(responseText, lang)\nactivate TTS\nTTS --&gt; VG : audioReply\ndeactivate TTS\nVG -&gt; C : play(audioReply)\nVG -&gt;&gt; AUD : logEvent(SESSION_END, chainHead)\ndeactivate VG\n\nnote over AUD\n  Each logEvent() appends one record:\n  H(i) = SHA-256( H(i-1) || payload || timestamp )\n  PII is redacted by the PII Redaction Service\n  before the payload is hashed and written.\nend note\n\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="-MX3oxgYZ-pnGT9fJNYo-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
