  <diagram name="Page-1" id="ETFhrwyvoDf8E0-UwILb">
    <mxGraphModel dx="1513" dy="899" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml DBSchema_VoiceAssistant\nhide circle\nskinparam linetype ortho\nskinparam shadowing false\n\nentity \&quot;LANGUAGE\&quot; as LANG {\n  * language_code : CHAR(5) &lt;&lt;PK&gt;&gt;\n  --\n  * language_name : VARCHAR(40)\n  * script : VARCHAR(20)\n}\n\nentity \&quot;CUSTOMER\&quot; as CUST {\n  * customer_id : VARCHAR(12) &lt;&lt;PK&gt;&gt;\n  --\n  * full_name : VARCHAR(120)\n  * phone_number : VARCHAR(15) &lt;&lt;UK&gt;&gt;\n  * preferred_language : CHAR(5) &lt;&lt;FK&gt;&gt;\n  * created_at : TIMESTAMP\n}\n\nentity \&quot;VOICE_PROFILE\&quot; as VP {\n  * profile_id : VARCHAR(20) &lt;&lt;PK&gt;&gt;\n  --\n  * customer_id : VARCHAR(12) &lt;&lt;FK,UK&gt;&gt;\n  * embedding_ref : VARCHAR(200)\n  * enrolled_at : TIMESTAMP\n  * status : VARCHAR(15)\n}\n\nentity \&quot;CONSENT_RECORD\&quot; as CONS {\n  * consent_id : VARCHAR(20) &lt;&lt;PK&gt;&gt;\n  --\n  * customer_id : VARCHAR(12) &lt;&lt;FK&gt;&gt;\n  * purpose : VARCHAR(60)\n  * granted_at : TIMESTAMP\n  withdrawn_at : TIMESTAMP\n}\n\nentity \&quot;INTENT_CATALOG\&quot; as IC {\n  * intent_code : VARCHAR(40) &lt;&lt;PK&gt;&gt;\n  --\n  * description : VARCHAR(150)\n  * sensitivity_level : SMALLINT\n  * default_risk_tier : VARCHAR(20)\n  * requires_auth : BOOLEAN\n}\n\nentity \&quot;CONVERSATION\&quot; as CONV {\n  * conversation_id : VARCHAR(24) &lt;&lt;PK&gt;&gt;\n  --\n  * customer_id : VARCHAR(12) &lt;&lt;FK&gt;&gt;\n  * channel : VARCHAR(15)\n  * started_at : TIMESTAMP\n  ended_at : TIMESTAMP\n  * status : VARCHAR(15)\n}\n\nentity \&quot;TURN\&quot; as TURN {\n  * turn_id : VARCHAR(24) &lt;&lt;PK&gt;&gt;\n  --\n  * conversation_id : VARCHAR(24) &lt;&lt;FK&gt;&gt;\n  * sequence_no : SMALLINT\n  * language_code : CHAR(5) &lt;&lt;FK&gt;&gt;\n  * transcript_text : TEXT\n  transcript_ref : VARCHAR(200)\n  * asr_confidence : NUMERIC(4,3)\n  response_text : TEXT\n  grounded_document_id : VARCHAR(20) &lt;&lt;FK&gt;&gt;\n  * created_at : TIMESTAMP\n  -- UNIQUE (conversation_id, sequence_no) --\n}\n\nentity \&quot;DETECTED_INTENT\&quot; as DI {\n  * intent_id : VARCHAR(24) &lt;&lt;PK&gt;&gt;\n  --\n  * turn_id : VARCHAR(24) &lt;&lt;FK,UK&gt;&gt;\n  * intent_code : VARCHAR(40) &lt;&lt;FK&gt;&gt;\n  * confidence : NUMERIC(4,3)\n}\n\nentity \&quot;EXTRACTED_ENTITY\&quot; as EE {\n  * intent_id : VARCHAR(24) &lt;&lt;PK,FK&gt;&gt;\n  * entity_type : VARCHAR(30) &lt;&lt;PK&gt;&gt;\n  --\n  * entity_value : VARCHAR(120)\n  * is_redacted : BOOLEAN\n}\n\nentity \&quot;RISK_ASSESSMENT\&quot; as RA {\n  * assessment_id : VARCHAR(24) &lt;&lt;PK&gt;&gt;\n  --\n  * turn_id : VARCHAR(24) &lt;&lt;FK,UK&gt;&gt;\n  * risk_score : NUMERIC(4,3)\n  * risk_tier : VARCHAR(20)\n  * decision : VARCHAR(20)\n  * evaluated_at : TIMESTAMP\n}\n\nentity \&quot;AUTH_ATTEMPT\&quot; as AA {\n  * attempt_id : VARCHAR(24) &lt;&lt;PK&gt;&gt;\n  --\n  * conversation_id : VARCHAR(24) &lt;&lt;FK&gt;&gt;\n  * method : VARCHAR(15)\n  speaker_score : NUMERIC(4,3)\n  spoof_score : NUMERIC(4,3)\n  * result : VARCHAR(10)\n  * attempted_at : TIMESTAMP\n}\n\nentity \&quot;BANKING_REQUEST\&quot; as BR {\n  * request_id : VARCHAR(24) &lt;&lt;PK&gt;&gt;\n  --\n  * turn_id : VARCHAR(24) &lt;&lt;FK,UK&gt;&gt;\n  amount : NUMERIC(14,2)\n  currency : CHAR(3)\n  * status : VARCHAR(15)\n  core_reference_no : VARCHAR(40)\n  executed_at : TIMESTAMP\n}\n\nentity \&quot;POLICY_DOCUMENT\&quot; as PD {\n  * document_id : VARCHAR(20) &lt;&lt;PK&gt;&gt;\n  --\n  * title : VARCHAR(150)\n  * version : VARCHAR(10)\n  * effective_from : DATE\n  * storage_ref : VARCHAR(200)\n  -- UNIQUE (title, version) --\n}\n\nentity \&quot;HUMAN_AGENT\&quot; as HA {\n  * agent_id : VARCHAR(12) &lt;&lt;PK&gt;&gt;\n  --\n  * employee_code : VARCHAR(20) &lt;&lt;UK&gt;&gt;\n  * full_name : VARCHAR(120)\n  * role : VARCHAR(30)\n  * available : BOOLEAN\n}\n\nentity \&quot;ESCALATION\&quot; as ESC {\n  * escalation_id : VARCHAR(24) &lt;&lt;PK&gt;&gt;\n  --\n  * conversation_id : VARCHAR(24) &lt;&lt;FK,UK&gt;&gt;\n  agent_id : VARCHAR(12) &lt;&lt;FK&gt;&gt;\n  * reason_code : VARCHAR(30)\n  * created_at : TIMESTAMP\n  resolved_at : TIMESTAMP\n  * status : VARCHAR(15)\n  outcome_notes : TEXT\n}\n\nentity \&quot;AUDIT_RECORD\&quot; as AR {\n  * record_id : BIGINT &lt;&lt;PK&gt;&gt;\n  --\n  * conversation_id : VARCHAR(24) &lt;&lt;FK&gt;&gt;\n  turn_id : VARCHAR(24) &lt;&lt;FK&gt;&gt;\n  * stage : VARCHAR(30)\n  * payload_hash : CHAR(64)\n  * prev_hash : CHAR(64)\n  * signature : VARCHAR(88)\n  * created_at : TIMESTAMP\n}\n\nLANG ||--o{ CUST\nLANG ||--o{ TURN\nCUST ||--|| VP\nCUST ||--o{ CONS\nCUST ||--o{ CONV\nCONV ||--|{ TURN\nCONV ||--o{ AA\nCONV ||--o| ESC\nCONV ||--|{ AR\nTURN ||--o| DI\nTURN ||--|| RA\nTURN ||--o| BR\nTURN }o--o| PD\nTURN ||--o{ AR\nDI  ||--o{ EE\nIC  ||--o{ DI\nHA  ||--o{ ESC\n\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="FrEobal3MNWZ8niBsABE-1">
