        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml UseCase_VoiceAssistant\nleft to right direction\nskinparam packageStyle rectangle\nskinparam shadowing false\n\nactor \&quot;Customer\&quot; as CUST\nactor \&quot;Bank Staff\&quot; as STAFF\nactor \&quot;Human Agent\&quot; as AGENT\nactor \&quot;Compliance Officer\&quot; as CO\nactor \&quot;Core Banking System\\n&lt;&lt;external&gt;&gt;\&quot; as CBS\n\nSTAFF &lt;|-- AGENT\nSTAFF &lt;|-- CO\n\nrectangle \&quot;Compliance-Aware Multilingual Voice Assistant\&quot; {\n\n  usecase \&quot;Place Voice Query in\\nPreferred / Code-Mixed Language\&quot; as UC1\n  usecase \&quot;Transcribe Speech and\\nDetect Language\&quot; as UC2\n  usecase \&quot;Classify Request Risk Tier\&quot; as UC3\n  usecase \&quot;Record Audit Entry\&quot; as UC4\n\n  usecase \&quot;Check Balance /\\nMini Statement\&quot; as UC5\n  usecase \&quot;Block Card\&quot; as UC6\n  usecase \&quot;Transfer Funds\&quot; as UC7\n  usecase \&quot;Report Fraud or Dispute\&quot; as UC8\n  usecase \&quot;Get Product / Policy\\nInformation\&quot; as UC9\n\n  usecase \&quot;Authenticate Customer\&quot; as UC10\n  usecase \&quot;Verify Speaker Voice\\nwith Spoof Check\&quot; as UC11\n  usecase \&quot;Confirm with OTP\&quot; as UC12\n  usecase \&quot;Escalate to Human Agent\&quot; as UC13\n  usecase \&quot;Manage Consent\&quot; as UC14\n\n  usecase \&quot;Handle Escalated\\nConversation\&quot; as UC15\n  usecase \&quot;Review Redacted\\nTranscripts\&quot; as UC16\n  usecase \&quot;View Interaction Analytics\&quot; as UC17\n  usecase \&quot;Export Compliance Logs\&quot; as UC18\n  usecase \&quot;Manage Policy\\nKnowledge Base\&quot; as UC19\n}\n\nCUST -- UC1\nCUST -- UC5\nCUST -- UC6\nCUST -- UC7\nCUST -- UC8\nCUST -- UC9\nCUST -- UC14\n\nAGENT -- UC15\nCO -- UC16\nCO -- UC17\nCO -- UC18\nCO -- UC19\n\nCBS -- UC5\nCBS -- UC6\nCBS -- UC7\n\nUC1 ..&gt; UC2 : &lt;&lt;include&gt;&gt;\nUC1 ..&gt; UC3 : &lt;&lt;include&gt;&gt;\nUC1 ..&gt; UC