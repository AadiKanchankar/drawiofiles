        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml Component_VoiceAssistant\nskinparam componentStyle uml2\nskinparam shadowing false\n\npackage \&quot;Compliance-Aware Multilingual Voice Assistant\&quot; {\n\n  component \&quot;Voice Gateway\&quot; as VG\n  component \&quot;ASR Service\&quot; &lt;&lt;Strategy&gt;&gt; &lt;&lt;Factory&gt;&gt; as ASR\n  component \&quot;TTS Service\&quot; as TTS\n  component \&quot;Dialogue Manager\&quot; as DM\n  component \&quot;Policy Knowledge Service\&quot; as KB\n  component \&quot;Risk Engine\&quot; as RE\n  component \&quot;Authentication Service\&quot; as AUTH\n  component \&quot;Banking Adapter\&quot; &lt;&lt;Adapter&gt;&gt; as BA\n  component \&quot;Escalation Engine\&quot; as ESC\n  component \&quot;Audit Ledger Service\&quot; &lt;&lt;Observer&gt;&gt; &lt;&lt;Singleton&gt;&gt; as AUD\n  component \&quot;PII Redaction Service\&quot; as PII\n  component \&quot;Persistence Layer\&quot; &lt;&lt;Repository&gt;&gt; as REPO\n  component \&quot;Admin &amp; Compliance Dashboard\&quot; &lt;&lt;MVC&gt;&gt; as DASH\n}\n\ncomponent \&quot;Core Banking System\&quot; as CBS\ncomponent \&quot;Agent Desk\&quot; as DESK\n\ninterface \&quot;ISpeechRecognition\&quot; as ISR\ninterface \&quot;ISpeechSynthesis\&quot; as ISS\ninterface \&quot;IDialogue\&quot; as IDLG\ninterface \&quot;IKnowledgeRetrieval\&quot; as IKR\ninterface \&quot;IRiskAssessment\&quot; as IRA\ninterface \&quot;IAuthentication\&quot; as IAUTH\ninterface \&quot;IBankingOperations\&quot; as IBO\ninterface \&quot;ICoreBankingAPI\&quot; as ICBA\ninterface \&quot;IEscalation\&quot; as IESC\ninterface \&quot;IAuditLog\&quot; as IAL\ninterface \&quot;IRedaction\&quot; as IRED\ninterface \&quot;IPersistence\&quot; as IPER\ninterface \&quot;IAgentDesk\&quot; as IAD\n\nASR  -- ISR\nTTS  -- ISS\nDM   -- IDLG\nKB   -- IKR\nRE   -- IRA\nAUTH -- IAUTH\nBA   -- IBO\nESC  -- IESC\nAUD  -- IAL\nPII  -- IRED\nREPO -- IPER\nCBS  -- ICBA\nDESK -- IAD\n\nVG ..&gt; ISR\nVG ..&gt; ISS\nVG ..&gt; IDLG\nVG ..&gt; IAL\n\nDM ..&gt; IRA\nDM ..&gt; IKR\nDM ..&gt; IAUTH\nDM ..&gt; IBO\nDM ..&gt; IESC\nDM ..&gt; IAL\nDM ..&gt; IPER\n\nRE   ..&gt; IAL\nAUTH ..&gt; IAL\nAUTH ..&gt; IPER\nBA   ..&gt; ICBA\nBA   ..&gt; IAL\nESC  ..&gt; IAD\nESC  ..&gt; IAL\nESC  ..&gt; IPER\nKB   ..&gt; IPER\nAUD  ..&gt; IRED\nAUD  ..&gt; IPER\nDASH ..&gt; IAL\nDASH ..&gt; IPER\n\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="9nP-uJIMM6S_atp0mLrN-1">
