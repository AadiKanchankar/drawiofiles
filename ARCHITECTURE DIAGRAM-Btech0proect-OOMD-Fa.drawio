        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml Architecture_VoiceAssistant\nskinparam componentStyle rectangle\nskinparam shadowing false\nskinparam defaultTextAlignment center\n\nactor \&quot;Customer\&quot; as CUST\nactor \&quot;Human Agent\&quot; as AGENT\nactor \&quot;Compliance Officer\&quot; as CO\n\npackage \&quot;Channel Layer\&quot; {\n  component \&quot;Voice Gateway\\n(Telephony / SIP / WebRTC)\&quot; as VG\n  component \&quot;Admin &amp; Compliance\\nDashboard (React)\&quot; as DASH\n  component \&quot;Agent Desk\&quot; as DESK\n}\n\npackage \&quot;Core Voice + AI Layer\&quot; {\n  component \&quot;ASR Service\\n(Language ID + finance-tuned\\nIndic ASR)\&quot; as ASR\n  component \&quot;Dialogue Manager\\n(Rasa NLU + dialogue policy)\&quot; as DM\n  component \&quot;Policy Knowledge Service\\n(retrieval-grounded answers)\&quot; as KB\n  component \&quot;Risk Engine\\n(4-tier classifier)\&quot; as RE\n  component \&quot;Escalation Engine\&quot; as ESC\n  component \&quot;TTS Service\\n(multilingual synthesis)\&quot; as TTS\n}\n\npackage \&quot;Integration / Middleware Layer\&quot; {\n  component \&quot;API Gateway\\n(REST / gRPC, RBAC enforcement)\&quot; as GW\n  component \&quot;Authentication Service\\n(speaker verification + spoof\\ncheck + OTP)\&quot; as AUTH\n  component \&quot;Banking Adapter\&quot; as BA\n  component \&quot;Session Store\&quot; as SS\n}\n\npackage \&quot;Compliance &amp; Security Layer\&quot; {\n  component \&quot;PII Redaction Service\&quot; as PII\n  component \&quot;Audit Ledger Service\\n(hash-chained, signed)\&quot; as AUD\n  component \&quot;Consent Manager\&quot; as CONS\n}\n\npackage \&quot;Persistence Layer\&quot; {\n  database \&quot;Operational DB\\n(PostgreSQL)\&quot; as OPDB\n  database \&quot;Policy Knowledge Base\\n(pgvector)\&quot; as KBDB\n  database \&quot;Encrypted Transcript\\nStore\&quot; as TSTORE\n}\n\ncloud \&quot;Core Banking System\\n(bank&#39;s existing APIs)\&quot; as CBS\n\nCUST --&gt; VG\nAGENT --&gt; DESK\nCO --&gt; DASH\n\nVG --&gt; ASR\nASR --&gt; DM\nDM --&gt; RE\nDM --&gt; KB\nDM --&gt; GW\nDM --&gt; ESC\nDM --&gt; TTS\nTTS --&gt; VG\nESC --&gt; DESK\n\nGW --&gt; AUTH\nGW --&gt; BA\nBA --&gt; CBS\nDM ..&gt; SS\n\nASR ..&gt; AUD\nDM ..&gt; AUD\nRE ..&gt; AUD\nAUTH ..&gt; AUD\nBA ..&gt; AUD\nESC ..&gt; AUD\nAUD --&gt; PII\nCONS --&gt; OPDB\n\nAUD --&gt; OPDB\nKB --&gt; KBDB\nPII --&gt; TSTORE\nGW --&gt; OPDB\nDASH --&gt; GW\nDESK --&gt; GW\n\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="Wbn7GtSttOux-p5cwUpU-1">
