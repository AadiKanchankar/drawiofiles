        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml Deployment_VoiceAssistant\nskinparam shadowing false\nskinparam componentStyle rectangle\n\nnode \&quot;Customer Telephone /\\nSmartphone\&quot; &lt;&lt;device&gt;&gt; as PHONE {\n  artifact \&quot;Voice Client / Dialer\&quot;\n}\n\nnode \&quot;Agent Workstation\&quot; &lt;&lt;device&gt;&gt; as AGENTWS {\n  artifact \&quot;Agent Desk (browser)\&quot;\n}\n\nnode \&quot;Compliance Officer\\nWorkstation\&quot; &lt;&lt;device&gt;&gt; as COWS {\n  artifact \&quot;Admin &amp; Compliance\\nDashboard (React SPA)\&quot;\n}\n\nnode \&quot;Telephony Gateway Server\&quot; &lt;&lt;node&gt;&gt; as TGS {\n  node \&quot;Asterisk + WebRTC\&quot; &lt;&lt;execution environment&gt;&gt; {\n    artifact \&quot;voice-gateway\&quot;\n  }\n}\n\nnode \&quot;Application Server\&quot; &lt;&lt;node&gt;&gt; as APP {\n  node \&quot;Docker / FastAPI (Python 3.11)\&quot; &lt;&lt;execution environment&gt;&gt; {\n    artifact \&quot;api-gateway\&quot;\n    artifact \&quot;dialogue-manager\&quot;\n    artifact \&quot;risk-engine\&quot;\n    artifact \&quot;authentication-service\&quot;\n    artifact \&quot;banking-adapter\&quot;\n    artifact \&quot;escalation-engine\&quot;\n    artifact \&quot;audit-ledger-service\&quot;\n    artifact \&quot;pii-redaction-service\&quot;\n    artifact \&quot;consent-manager\&quot;\n    artifact \&quot;policy-knowledge-service\&quot;\n  }\n}\n\nnode \&quot;AI Inference Server (GPU)\&quot; &lt;&lt;node&gt;&gt; as AI {\n  node \&quot;Python / PyTorch runtime\&quot; &lt;&lt;execution environment&gt;&gt; {\n    artifact \&quot;asr-service\\n(finance-tuned Indic ASR)\&quot;\n    artifact \&quot;tts-service\&quot;\n    artifact \&quot;speaker-verification\\n+ spoof countermeasure\&quot;\n  }\n}\n\nnode \&quot;Database Server\&quot; &lt;&lt;node&gt;&gt; as DB {\n  database \&quot;PostgreSQL + pgvector\&quot; as PG {\n    artifact \&quot;operational schema\&quot;\n    artifact \&quot;policy knowledge base\&quot;\n  }\n  database \&quot;Redis\&quot; as REDIS {\n    artifact \&quot;session store\&quot;\n  }\n}\n\nnode \&quot;Secure Object Storage\&quot; &lt;&lt;node&gt;&gt; as OBJ {\n  database \&quot;Encrypted Transcript Store\\n(AES-256 at rest)\&quot; as TSTORE\n}\n\nnode \&quot;Core Banking System\&quot; &lt;&lt;external&gt;&gt; as CBS {\n  artifact \&quot;Core Banking REST / gRPC API\&quot;\n}\n\nPHONE   -- TGS     : SIP / RTP\nTGS     -- APP     : HTTPS (TLS 1.3) / WebSocket\nAGENTWS -- APP     : HTTPS + WSS (RBAC)\nCOWS    -- APP     : HTTPS (OAuth 2.0, RBAC)\nAPP     -- AI      : gRPC over TLS\nAPP     -- DB      : PostgreSQL wire protocol (TLS)\nAPP     -- OBJ     : HTTPS (S3 API)\nAPP     -- CBS     : REST / gRPC over mTLS\n\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="poh0K9MCSeKvxe5aQVEX-1">
