  <diagram name="Page-1" id="jbCz9J6z8-P07xnAgouH">
    <mxGraphModel dx="1072" dy="637" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml ClassDiagram_VoiceAssistant\nskinparam classAttributeIconSize 0\nskinparam shadowing false\nhide circle\n\nenum RiskTier {\n  INFORMATIONAL\n  ACCOUNT_SPECIFIC\n  TRANSACTIONAL\n  HIGH_RISK\n}\n\nclass Customer {\n  - customerId : String\n  - fullName : String\n  - phoneNumber : String\n  - preferredLanguage : String\n  + hasActiveConsent(purpose : String) : boolean\n}\n\nclass VoiceProfile {\n  - profileId : String\n  - embeddingRef : String\n  - enrolledAt : DateTime\n  - status : String\n  + isEnrolled() : boolean\n}\n\nclass ConsentRecord {\n  - consentId : String\n  - purpose : String\n  - grantedAt : DateTime\n  - withdrawnAt : DateTime\n  + isActive() : boolean\n  + withdraw() : void\n}\n\nclass Conversation {\n  - conversationId : String\n  - channel : String\n  - startedAt : DateTime\n  - endedAt : DateTime\n  - status : String\n  + addTurn(t : Turn) : void\n  + close() : void\n}\n\nclass Turn {\n  - turnId : String\n  - sequenceNo : int\n  - detectedLanguage : String\n  - transcriptText : String\n  - asrConfidence : float\n  - responseText : String\n  - createdAt : DateTime\n  + isLowConfidence(threshold : float) : boolean\n}\n\nclass Intent {\n  - intentId : String\n  - intentCode : String\n  - confidence : float\n  - entities : Map&lt;String,String&gt;\n  + isAboveThreshold(tau : float) : boolean\n}\n\nclass RiskAssessment {\n  - assessmentId : String\n  - riskScore : float\n  - tier : RiskTier\n  - decision : String\n  - evaluatedAt : DateTime\n  + requiresAuthentication() : boolean\n  + requiresHumanAgent() : boolean\n}\n\nabstract class AuthenticationAttempt {\n  - attemptId : String\n  - attemptedAt : DateTime\n  - result : String\n  + {abstract} verify() : boolean\n}\n\nclass VoiceVerification {\n  - speakerScore : float\n  - spoofScore : float\n  + verify() : boolean\n}\n\nclass OTPVerification {\n  - deliveryChannel : String\n  - expiresAt : DateTime\n  + verify() : boolean\n}\n\nclass BankingRequest {\n  - requestId : String\n  - amount : Decimal\n  - currency : String\n  - status : String\n  - coreReferenceNo : String\n  - executedAt : DateTime\n  + submit() : void\n}\n\nclass PolicyDocument {\n  - documentId : String\n  - title : String\n  - version : String\n  - effectiveFrom : Date\n  + isCurrent() : boolean\n}\n\nclass Escalation {\n  - escalationId : String\n  - reasonCode : String\n  - createdAt : DateTime\n  - resolvedAt : DateTime\n  - status : String\n  + assignTo(a : HumanAgent) : void\n  + resolve(notes : String) : void\n}\n\nclass HumanAgent {\n  - agentId : String\n  - fullName : String\n  - role : String\n  - available : boolean\n  + accept(e : Escalation) : void\n}\n\nclass AuditRecord {\n  - recordId : String\n  - stage : String\n  - payloadHash : String\n  - prevHash : String\n  - signature : String\n  - createdAt : DateTime\n  + verifyChain(previous : AuditRecord) : boolean\n}\n\nCustomer \&quot;1\&quot; *-- \&quot;0..1\&quot; VoiceProfile\nCustomer \&quot;1\&quot; -- \&quot;0..*\&quot; ConsentRecord : grants &gt;\nCustomer \&quot;1\&quot; -- \&quot;0..*\&quot; Conversation : initiates &gt;\n\nConversation \&quot;1\&quot; *-- \&quot;1..*\&quot; Turn : contains &gt;\nConversation \&quot;1\&quot; -- \&quot;0..*\&quot; AuthenticationAttempt\nConversation \&quot;1\&quot; -- \&quot;0..1\&quot; Escalation\nConversation \&quot;1\&quot; -- \&quot;1..*\&quot; AuditRecord : produces &gt;\n\nTurn \&quot;1\&quot; -- \&quot;0..1\&quot; Intent : detected &gt;\nTurn \&quot;1\&quot; -- \&quot;1\&quot; RiskAssessment : scored by &gt;\nTurn \&quot;1\&quot; -- \&quot;0..1\&quot; BankingRequest : triggers &gt;\nTurn \&quot;0..*\&quot; --&gt; \&quot;0..1\&quot; PolicyDocument : grounded on &gt;\n\nAuthenticationAttempt &lt;|-- VoiceVerification\nAuthenticationAttempt &lt;|-- OTPVerification\nVoiceVerification ..&gt; VoiceProfile : compares against\n\nEscalation \&quot;0..*\&quot; -- \&quot;0..1\&quot; HumanAgent : handled by &gt;\nAuditRecord \&quot;1\&quot; --&gt; \&quot;0..1\&quot; AuditRecord : previous\nRiskAssessment ..&gt; RiskTier\n\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="iG76TT7SRkfoaDW7V1UM-1">
